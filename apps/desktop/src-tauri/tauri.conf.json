{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OSS Client",
  "version": "0.1.0",
  "identifier": "cn.caorushizi.ossclient",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:7789",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "OSS Client",
        "width": 1090,
        "height": 645,
        "minWidth": 750,
        "minHeight": 350,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "shadow": true
      },
      {
        "label": "float",
        "title": "OSS Client Float",
        "width": 67,
        "height": 67,
        "visible": false,
        "focus": false,
        "transparent": true,
        "decorations": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "font-src": "'self'",
        "img-src": "'self' asset: http://asset.localhost data: blob:",
        "style-src": "'self' 'unsafe-inline'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/oss-sidecar"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
