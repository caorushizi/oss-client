{
  "name": "oss-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm sidecar:build && pnpm --filter @oss-client/desktop tauri dev",
    "dev:web": "pnpm --filter @oss-client/desktop dev",
    "build": "pnpm sidecar:build && pnpm --filter @oss-client/desktop tauri build",
    "build:web": "pnpm --filter @oss-client/desktop build",
    "sidecar:dev": "go -C ./services/oss-sidecar run ./cmd/oss-sidecar",
    "sidecar:build": "node ./scripts/build-sidecar.mjs",
    "contracts:generate": "pnpm --filter @oss-client/contracts generate",
    "check": "pnpm check:frontend && pnpm check:go && pnpm check:rust",
    "check:frontend": "pnpm --filter @oss-client/desktop check",
    "check:go": "go -C ./services/oss-sidecar test ./...",
    "check:rust": "cargo fmt --manifest-path ./apps/desktop/src-tauri/Cargo.toml --check && cargo check --manifest-path ./apps/desktop/src-tauri/Cargo.toml",
    "lint": "oxlint --type-aware ./apps/desktop/src ./apps/desktop/vite.config.ts",
    "format": "oxfmt .",
    "deps:check": "taze --recursive --silent --fail-on-outdated"
  },
  "devDependencies": {
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "oxlint-tsgolint": "7.0.2001",
    "taze": "21.1.0"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.25.0"
}
